---
import { url } from "../lib/paths";
import { stamp, updated, venue, standingsUrl } from "../lib/club";
const year = new Date().getFullYear();
---
<footer class="footer" id="contacto">
  <div class="wrap footer-grid">
    <div>
      <a class="brand" href={url()}><img class="brand-mark" src={url("img/escudo.png")} alt="" width="30" height="34"><span>CD Tarancón</span></a>
      <p>{venue}<br>Tarancón, Cuenca · Castilla-La Mancha</p>
    </div>
    <nav aria-label="Pie de página">
      <h3>Web</h3>
      <ul>
        <li><a href={url("#partido")}>Próximo partido</a></li>
        <li><a href={url("#calendario")}>Calendario y resultados</a></li>
        <li><a href={url("noticias/")}>Noticias</a></li>
        <li><a href={url("tienda/")}>Tienda</a></li>
        <li><a href={url("abonados/")}>Abonados</a></li>
      </ul>
    </nav>
    <div>
      <h3>Más información</h3>
      <ul>
        <li><a href={standingsUrl} target="_blank" rel="noopener">Clasificación en BeSoccer</a></li>
        <li><a href="https://futbolme.com/resultados-directo/equipo/cd-tarancon/8904/calendario" target="_blank" rel="noopener">Calendario en Futbolme</a></li>
      </ul>
    </div>
  </div>
  <p class="legal">
    © {year} CD Tarancón. Web no oficial. Datos de BeSoccer; la lista de jugadores puede estar incompleta.
    <span id="updated">Datos actualizados el {stamp(updated)}.</span>
  </p>
</footer>
